<Workflow>
  <Name>Right To Left; Palm Prints (Upper/Lower/Writers)</Name>
  <Step>
    <UseAutoCapture>true</UseAutoCapture>
    <UseAutoContrast>true</UseAutoContrast>
    <Fingerprint>
      <Position>RightUpperPalm</Position>
      <Impression>LivescanPlain</Impression>
      <UseAsCtrlFinger>true</UseAsCtrlFinger>
    </Fingerprint>
  </Step>
  <Step>
    <UseAutoCapture>true</UseAutoCapture>
    <UseAutoContrast>true</UseAutoContrast>
    <Fingerprint>
      <Position>RightLowerPalm</Position>
      <Impression>LivescanPlain</Impression>
      <UseAsCtrlFinger>true</UseAsCtrlFinger>
    </Fingerprint>
  </Step>
  <Step>
    <UseAutoCapture>true</UseAutoCapture>
    <UseAutoContrast>true</UseAutoContrast>
    <Fingerprint>
      <Position>RightWritersPalm</Position>
      <Impression>LivescanPlain</Impression>
      <UseAsCtrlFinger>true</UseAsCtrlFinger>
    </Fingerprint>
  </Step>
  <Step>
    <UseAutoCapture>true</UseAutoCapture>
    <UseAutoContrast>true</UseAutoContrast>
    <Fingerprint>
      <Position>LeftUpperPalm</Position>
      <Impression>LivescanPlain</Impression>
      <UseAsCtrlFinger>true</UseAsCtrlFinger>
    </Fingerprint>
  </Step>
  <Step>
    <UseAutoCapture>true</UseAutoCapture>
    <UseAutoContrast>true</UseAutoContrast>
    <Fingerprint>
      <Position>LeftLowerPalm</Position>
      <Impression>LivescanPlain</Impression>
      <UseAsCtrlFinger>true</UseAsCtrlFinger>
    </Fingerprint>
  </Step>
  <Step>
    <UseAutoCapture>true</UseAutoCapture>
    <UseAutoContrast>true</UseAutoContrast>
    <Fingerprint>
      <Position>LeftWritersPalm</Position>
      <Impression>LivescanPlain</Impression>
      <UseAsCtrlFinger>true</UseAsCtrlFinger>
    </Fingerprint>
  </Step>
</Workflow>
