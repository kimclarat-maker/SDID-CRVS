VITE_NODE_ENV=development
VITE_APP_NAME=SDID-ENROLLMENT
VITE_CLIENT=
VITE_API_KEY=
VITE_API_SECRET_KEY=
VITE_DEVELOPMENT_API=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Optional deployment pack for country-specific naming/geography/services.
# "generic" (default) is country-neutral. "rwanda" enables the Rwanda-specific
# authority names, languages and administrative-area hierarchy.
VITE_DEPLOYMENT=generic

# Demo mode: local mock auth + fictional seed data, no live backend required.
# Must stay "false" in production. See README.md for demo accounts and how
# to explore the app with VITE_DEMO_MODE=true.
VITE_DEMO_MODE=false
